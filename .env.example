# ─── Backend ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# CORS: origines autorisées (séparées par des virgules). "*" = toutes (dev).
# En production : CORS_ORIGIN="https://app.smartpromo.ma"
CORS_ORIGIN="*"

# PostgreSQL (via docker-compose) — see docker-compose.yml
DATABASE_URL="postgresql://smartpromo:smartpromo@localhost:5432/smartpromo?schema=public"

# Redis (queues / cache)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Claude (Anthropic) — optionnel. Sans clé, le moteur fonctionne en mode règles.
ANTHROPIC_API_KEY=""
# Modèle Claude (claude-opus-4-8 par défaut ; claude-haiku-4-5 = moins cher / plus rapide)
ANTHROPIC_MODEL="claude-opus-4-8"

# Météo (optionnel — OpenWeatherMap). Sans clé, des données simulées sont utilisées.
OPENWEATHER_API_KEY=""

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
