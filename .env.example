# ─── Backend ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# CORS: origines autorisées (séparées par des virgules). "*" = toutes (dev).
# En production : CORS_ORIGIN="https://app.smartpromo.ma"
CORS_ORIGIN="*"

# PostgreSQL (via docker-compose) — see docker-compose.yml
DATABASE_URL="postgresql://smartpromo:smartpromo@localhost:5432/smartpromo?schema=public"

# Redis (queues / cache)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# OpenAI (optionnel — le moteur fonctionne aussi sans clé, en mode règles)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Météo (optionnel — OpenWeatherMap). Sans clé, des données simulées sont utilisées.
OPENWEATHER_API_KEY=""

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
