# Serveur
PORT=4000
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assistant_prof?schema=public"

# Authentification
JWT_SECRET="changez-moi-en-production-avec-une-chaine-longue-et-aleatoire"
JWT_EXPIRES_IN="7d"

# OpenAI (optionnel en dev : un générateur de démonstration est utilisé si absent)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# CORS - URL du frontend
FRONTEND_URL="http://localhost:3000"

# Quota du pack gratuit (générations par mois)
FREE_PLAN_MONTHLY_LIMIT=5
